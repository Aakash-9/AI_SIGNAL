# Copy this file to ".env" and fill in a key for ONE provider, then set
# LLM_PROVIDER to match. Both have free tiers.
#
#   Groq   (fast, recommended): https://console.groq.com/keys
#   Gemini:                     https://aistudio.google.com/apikey

LLM_PROVIDER=groq

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
